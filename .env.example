# Copy this file to .env and edit values for your machine.
# Never commit the real .env file.

APP_NAME=SwasthyaSetu AI
ENVIRONMENT=development

# PostgreSQL connection string (PGAdmin / psql user, password, database).
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/swasthyasetu
AUTO_CREATE_TABLES=true

# Generate a strong random value, e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
# If left blank, a temporary per-process secret is generated (tokens reset on restart).
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 'mock' is the hackathon demo speech service. A real adapter can replace it.
VOICE_PROVIDER=mock

# Illustrative demo rule version. Not clinically validated.
TRIAGE_RULE_VERSION=demo-v1
TRIAGE_SPO2_EMERGENCY=90
TRIAGE_SYSTOLIC_LOW_EMERGENCY=90
TRIAGE_RESPIRATORY_HIGH_EMERGENCY=30
TRIAGE_TEMPERATURE_PROMPT=39
TRIAGE_PULSE_HIGH_PROMPT=120
TRIAGE_SYSTOLIC_HIGH_PROMPT=180
TRIAGE_DIASTOLIC_HIGH_PROMPT=120
TRIAGE_REQUIRED_VITALS=temperature,pulse,systolic_bp,diastolic_bp,oxygen_saturation,respiratory_rate

REGISTRATION_OPEN=true
ALLOW_ADMIN_REGISTRATION=false
